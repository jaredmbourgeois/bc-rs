{
  "uid": "store_server-checkout-health",
  "title": "Checkout health",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "timeseries",
      "title": "p95 latency by route",
      "description": "95th-percentile request latency per route over five minutes",
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(time, '5m'),\n       \"route\",\n       percentile_cont(0.95) WITHIN GROUP (ORDER BY value) AS value\nFROM telemetry.\"metric__store_server__request_duration\"\nWHERE $__timeFilter(time)\nGROUP BY 1, \"route\"\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "title": "Orders per second",
      "description": "Orders placed per second",
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(time, '30s'),\n       sum(value) / 30 AS value\nFROM telemetry.\"metric__store_server__orders_placed\"\nWHERE $__timeFilter(time)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "table",
      "title": "Failed orders by reason",
      "description": "Failed orders per hour, by reason",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(time, '1h'),\n       \"reason\",\n       count(*) AS value\nFROM telemetry.\"log__store_server__order_failed\"\nWHERE $__timeFilter(time)\nGROUP BY 1, \"reason\"\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "p90 settlement time",
      "description": "90th-percentile settlement time per processor over fifteen minutes",
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(time, '15m'),\n       \"processor\",\n       percentile_cont(0.9) WITHIN GROUP (ORDER BY value) AS value\nFROM telemetry.\"metric__payments__settlement_duration\"\nWHERE $__timeFilter(time)\nGROUP BY 1, \"processor\"\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "logs",
      "title": "Failed orders",
      "description": "An order that reached checkout and did not complete",
      "id": 5,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT time, body, severity AS level, \"order_id\", \"reason\"\nFROM telemetry.\"log__store_server__order_failed\"\nWHERE $__timeFilter(time)\nORDER BY time DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "logs",
      "title": "Declined authorizations",
      "description": "The processor declined the authorization",
      "id": 6,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT time, body, severity AS level, \"order_id\", \"processor_code\"\nFROM telemetry.\"error__payments__authorization_declined\"\nWHERE $__timeFilter(time)\nORDER BY time DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
