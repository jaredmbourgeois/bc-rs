{
  "uid": "payments-payments-health",
  "title": "Payments health",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "timeseries",
      "title": "p90 settlement time by processor",
      "description": "90th-percentile settlement time per processor over fifteen minutes",
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(time, '15m'),\n       \"processor\",\n       percentile_cont(0.9) WITHIN GROUP (ORDER BY value) AS value\nFROM telemetry.\"metric__payments__settlement_duration\"\nWHERE $__timeFilter(time)\nGROUP BY 1, \"processor\"\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "title": "Response bytes",
      "description": "Bytes received from the processor per hour",
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(time, '1h'),\n       sum(value) AS value\nFROM telemetry.\"metric__payments__response_size\"\nWHERE $__timeFilter(time)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Checkouts per second",
      "description": "Checkouts started per second",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(time, '1m'),\n       count(*)::double precision / 60 AS value\nFROM telemetry.\"span__store_server__checkout\"\nWHERE $__timeFilter(time)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "logs",
      "title": "Processor timeouts",
      "description": "The processor did not answer in time",
      "id": 4,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT time, body, severity AS level, \"processor\", \"waited\"\nFROM telemetry.\"log__payments__processor_timeout\"\nWHERE $__timeFilter(time)\nORDER BY time DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
